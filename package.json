{
  "name": "pi-ste",
  "version": "0.1.0",
  "description": "Simplified Technical English (ASD-STE100) enforcement for pi. Rule engine in Gleam.",
  "type": "module",
  "license": "MIT",
  "author": "Cameron Moore",
  "repository": "github:ctotheameron/pi-ste",
  "homepage": "https://github.com/ctotheameron/pi-ste",
  "keywords": ["pi-package", "simplified-technical-english", "asd-ste100", "lint"],
  "bin": {
    "ste-lint": "./bin/ste-lint.mjs"
  },
  "files": [
    "dist",
    "src/host",
    "bin",
    "extension.mjs",
    ".claude-plugin",
    "hooks",
    "commands",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extension.mjs"
    ]
  },
  "scripts": {
    "build": "./scripts/build-dist.sh",
    "prepublishOnly": "./scripts/build-dist.sh",
    "test": "gleam test && node --test \"test/host/*.test.mjs\"",
    "lint": "./bin/ste-lint.mjs README.md commands/ste.md"
  }
}
