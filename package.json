{
  "name": "agent-ste",
  "version": "0.3.0",
  "description": "Simplified Technical English (ASD-STE100) enforcement for pi. Rule engine in Gleam.",
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "ste",
    "asd-ste100",
    "simplified-technical-english",
    "technical-writing",
    "claude-code",
    "claude-code-plugin",
    "lint",
    "linter",
    "prose",
    "gleam"
  ],
  "homepage": "https://github.com/ctotheameron/agent-ste#readme",
  "bugs": {
    "url": "https://github.com/ctotheameron/agent-ste/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ctotheameron/agent-ste.git"
  },
  "author": "ctotheameron (https://github.com/ctotheameron)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "ste-lint": "bin/ste-lint.mjs"
  },
  "files": [
    "dist",
    "src/host",
    "bin",
    "extension.mjs",
    ".claude-plugin",
    "hooks",
    "commands",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extension.mjs"
    ]
  },
  "scripts": {
    "build": "./scripts/build-dist.sh",
    "prepublishOnly": "./scripts/build-dist.sh",
    "test": "gleam test && node --test \"test/host/*.test.mjs\"",
    "lint": "./scripts/lint-prose.sh",
    "check:version": "./scripts/check-version.sh",
    "check:dist": "./scripts/check-dist.sh"
  }
}
